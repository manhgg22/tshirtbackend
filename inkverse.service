[Unit]
Description=Inkverse Node.js Application
Documentation=https://inkverse.online
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/inkverse/server
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=inkverse

# Environment variables
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=DB_ENVIRONMENT=atlas

[Install]
WantedBy=multi-user.target
